{
  "schema_version": 2,
  "agent_id": "REPLACE_WITH_FLEETD_AGENT_ID",
  "working_directory": "/absolute/path/to/worktree",
  "additional_directories": [],
  "mcp_grants": [],
  "adapter": {
    "kind": "envelope",
    "inbound": {
      "schema_version": 1,
      "message_kinds": ["work.request/v1"]
    }
  },
  "plugin": {
    "id": "fleetd.harness.deepseek",
    "executable": "/absolute/path/to/fleetd-harness-deepseek",
    "args": [],
    "config": {
      "executable": "/absolute/path/to/dsh",
      "expected_version": "0.0.1",
      "home": "/absolute/home/path",
      "dsh_home": "/absolute/path/to/private/.dsh",
      "path": "/explicit/non-secret/path",
      "term": "xterm-256color",
      "tmpdir": "/absolute/private/tmp/path",
      "tools_mode": "ptc",
      "provider": "zai",
      "model": "glm-5.3"
    },
    "initialize_timeout_ms": 30000,
    "request_timeout_ms": 30000,
    "shutdown_timeout_ms": 5000
  },
  "result_kind": "work.result/v1",
  "lease_duration_ms": 900000,
  "poll_interval_ms": 1000,
  "restart_backoff_ms": 5000,
  "pre_arm_retry_delay_ms": 5000,
  "turn": {
    "idle_timeout_ms": 120000,
    "wall_timeout_ms": 600000,
    "cancel_drain_timeout_ms": 15000,
    "interrupt_on_new_message": true,
    "interrupt_poll_interval_ms": 250,
    "max_captured_output_bytes": 524288,
    "tool_budget": 64
  }
}
