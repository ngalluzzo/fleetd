{
  "name": "@fleetd/conversation-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:application && npm run build:styles && npm run build:shell",
    "build:application": "bun build src/main.ts --target browser --format=iife --outfile=../../web/conversation/conversation.js",
    "build:styles": "bun build src/styles/index.css --target browser --outfile=../../web/conversation/conversation.css",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:shell": "cp index.html contract.json ../../web/conversation/"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
