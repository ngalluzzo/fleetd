#!/bin/sh
set -eu

cargo run --quiet --bin export-openapi
git diff --exit-code -- openapi/fleetd-v1.json
(
    cd clients/typescript
    npm ci
    npm run generate
    npm run typecheck
    npm test
    npm audit --audit-level=moderate
    if grep -Eq "streamChannelMessages|openBrowserChannelStream" src/generated/index.ts; then
        echo "WebSocket upgrades must not be emitted as Fetch operations" >&2
        exit 1
    fi
)
git diff --exit-code -- clients/typescript/src/generated

(
    cd apps/conversation-web
    bun run typecheck
    bun test
    bun run build
)
git diff --exit-code -- web/conversation/conversation.js
git diff --exit-code -- web/conversation/conversation.css
bun build tools/qualify-live-conversation.ts --target bun \
    --outfile target/qualify-live-conversation-check.js

(
    cd apps/conversation-desktop
    npm ci
    npm run typecheck
    npm test
)

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo test --workspace --all-targets --all-features
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features
