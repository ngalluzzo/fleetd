#!/usr/bin/env bash
# Dispatch one GitHub issue to a fleet seat.
#
# The backlog is GitHub Issues; fleetd owns how the work happened, not what
# work there is. This is the seam between them, and it is deliberately thin:
# one channel per issue, then one addressed message.
#
# A channel per issue is not cosmetic. One durable session binding serves a
# channel, so a shared channel would accumulate every issue into one native
# session that is never rotated. Per-issue channels keep each task's reasoning
# in its own session -- and keep the author's turn and the review of it in one
# place, readable by a single `fleetd trace`.
#
#   bin/assign 42                 # dispatch issue 42 to the author seat
#   bin/assign 42 reviewer        # hand the same issue to the reviewer
set -euo pipefail

issue="${1:?usage: bin/assign <issue-number> [seat]}"
seat="${2:-author}"

case "$seat" in
  author)   kind="work.request/v1"   ; instructions="docs/seats/author.md"   ;;
  reviewer) kind="review.request/v1" ; instructions="docs/seats/reviewer.md" ;;
  *) echo "unknown seat '$seat' (expected author or reviewer)" >&2; exit 2 ;;
esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fleetd="$root/target/debug/fleetd"
repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"

# The issue is the source of truth for what to do. Fetch it rather than making
# the operator retype it, so the dispatched text and the backlog cannot drift.
issue_json="$(gh issue view "$issue" --json number,title,body,url,labels)"

agent_id() {
  "$fleetd" agent list \
    | python3 -c "import sys,json;print([a['id'] for a in json.load(sys.stdin) if a['name']=='$1'][0])"
}
planner="$(agent_id planner)"
author="$(agent_id author)"
reviewer="$(agent_id reviewer)"

# Find or create. A hand-off from author to reviewer is the same issue, so it
# belongs in the same channel; channel names are unique, so creating twice is a
# conflict rather than a second room.
channel="$("$fleetd" channel list \
  | python3 -c "import sys,json;print(next((c['id'] for c in json.load(sys.stdin) if c['name']=='issue-$issue'), ''))")"
if [ -z "$channel" ]; then
  channel="$("$fleetd" channel create \
    --name "issue-$issue" \
    --member "$planner" --member "$author" --member "$reviewer" \
    --metadata "$(printf '%s' "$issue_json" \
      | python3 -c 'import sys,json;d=json.load(sys.stdin);print(json.dumps({"issue":d["number"],"url":d["url"]}))')" \
    | python3 -c 'import sys,json;print(json.load(sys.stdin)["id"])')"
fi

# A seat's worktree drifts from main the moment anything else commits, and a
# seat cannot read instructions that are not in its checkout. Sync before
# dispatching, or the turn spends its budget rediscovering the repository.
sync_worktree() {
  local dir="$1" target="$2"
  git -C "$dir" fetch --quiet origin 2>/dev/null || true
  # Detached: the branch under review is checked out in the author's worktree,
  # and git refuses to check one branch out twice.
  git -C "$dir" switch --quiet --detach "$target"
  echo "  $dir -> $(git -C "$dir" rev-parse --short HEAD) ($target)" >&2
}

case "$seat" in
  author) recipient="$author" ; subject="{}" ; sync_worktree "$HOME/repos/fleetd-seats/author" main ;;
  reviewer)
    recipient="$reviewer"
    # What the reviewer needs that the issue does not carry: the pull request to
    # read, and the way into the author's reasoning. `fleetd transcript` reads
    # the database directly and is addressed by native session reference, so the
    # planner resolves it here rather than making the seat go looking.
    subject="$(
      "$fleetd" message list --channel "$channel" \
      | python3 -c "
import json, subprocess, sys
messages = json.load(sys.stdin)['messages']
results = [m for m in messages if m['kind'] == 'work.result/v1']
if not results:
    sys.exit('no author result in issue-$issue yet; dispatch the author first')
invocation = results[-1]['payload'].get('invocation_id')

status = json.loads(subprocess.run(
    ['$fleetd', 'status', '--agent', '$author'],
    capture_output=True, text=True, check=True).stdout)
session = next((b.get('session_ref') for b in status.get('current_session_bindings', [])
                if b.get('lane_key') == '$channel'), None)

pulls = json.loads(subprocess.run(
    ['gh', 'pr', 'list', '--search', 'linked:issue', '--json', 'number,url,headRefName,title'],
    capture_output=True, text=True, check=True).stdout)
pull = next((p for p in pulls if 'issue-$issue-' in p['headRefName']), pulls[0] if pulls else None)

print(json.dumps({
    'pull_request': pull,
    'author_invocation_id': invocation,
    'author_session_ref': session,
    'transcript_command': (
        'cd $root && ./target/debug/fleetd transcript '
        '--config .fleetd/worker-author.json --session ' + (session or '<unknown>')),
    'trace_command': 'cd $root && ./target/debug/fleetd trace --invocation ' + (invocation or '<unknown>'),
}))")"
    sync_worktree "$HOME/repos/fleetd-seats/reviewer" \
      "$(printf '%s' "$subject" | python3 -c 'import sys,json;print(json.load(sys.stdin)["pull_request"]["headRefName"])')"
    ;;
esac

payload="$(printf '%s' "$issue_json" | python3 -c "
import sys, json
issue = json.load(sys.stdin)
print(json.dumps({
    'repository': '$repo',
    'issue': issue['number'],
    'url': issue['url'],
    'title': issue['title'],
    'body': issue['body'] or '',
    'labels': [l['name'] for l in issue['labels']],
    'instructions': '$instructions',
    'base_branch': 'main',
    **json.loads('''$subject'''),
}))")"

# The idempotency key is the issue and the seat, so dispatching twice by
# accident hands the seat one piece of work rather than two.
"$fleetd" --token-file .fleetd/planner.token message send \
  --channel "$channel" \
  --to "$recipient" \
  --kind "$kind" \
  --idempotency-key "assign/$issue/$seat" \
  --payload "$payload" > /dev/null

echo "issue $issue -> $seat  channel=$channel" >&2
