#!/bin/sh
# Regenerates every committed derived artifact, in dependency order.
#
# Each stage consumes the previous one: the contract is collected from the Rust
# adapters, the TypeScript client is generated from the contract, and the served
# bundle is built from the client. Some Rust adapters are separately generated
# and admitted upstream; this script deliberately does not invoke an ambient
# sibling compiler or mutate those source files.
#
# This is also how a merge conflict in the downstream paths is resolved: they
# are marked unmergeable in `.gitattributes`, so take either side and run this.
set -eu

cargo run --quiet --bin export-openapi
npm run generate
npm run build
