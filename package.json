{
  "name": "fleetd-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "clients/typescript",
    "apps/conversation-web",
    "apps/conversation-desktop"
  ],
  "scripts": {
    "build": "npm run build -w @fleetd/conversation-web",
    "generate": "npm run generate -w @fleetd/client",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "verify": "npm run test && npm run typecheck && npm run verify:generated",
    "verify:generated": "node scripts/verify-generated.mjs"
  }
}
