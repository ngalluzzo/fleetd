{
  "name": "@fleetd/client",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser-channel-stream": "./src/browser-channel-stream.ts",
    "./conversation": "./src/conversation-session.ts",
    "./conversation-transport": "./src/conversation-transport.ts",
    "./operator": "./src/operator-client.ts",
    "./client": "./src/generated/client.gen.ts",
    "./types": "./src/generated/types.gen.ts"
  },
  "scripts": {
    "generate": "openapi-ts",
    "test": "node --experimental-strip-types --test test/browser-channel-stream.test.mjs test/conversation-session.test.mjs && bun test test/operator-client.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "js-yaml": "5.3.0"
  }
}
